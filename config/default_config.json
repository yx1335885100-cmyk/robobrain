{
    "brain": {
        "max_iterations": 10,
        "session_timeout": 300,
        "enable_llm": true
    },
    "graph": {
        "checkpointer": "memory",
        "streaming": true
    },
    "nodes": {
        "perception": {
            "enable_asr": true,
            "enable_vision": true,
            "confidence_threshold": 0.5
        },
        "planning": {
            "strategy": "hierarchical",
            "max_subtasks": 10,
            "use_llm": true
        },
        "scheduling": {
            "algorithm": "priority_based",
            "max_concurrent": 1
        },
        "execution": {
            "timeout": 60.0,
            "max_retries": 3
        },
        "feedback": {
            "enable_reflection": true,
            "reflection_threshold": 0.5
        }
    },
    "tools": {
        "vln": {
            "max_velocity": 0.5,
            "safety_distance": 0.3
        },
        "vla": {
            "grasp_force": 10.0,
            "approach_speed": 0.1
        }
    },
    "logging": {
        "level": "INFO"
    }
}
